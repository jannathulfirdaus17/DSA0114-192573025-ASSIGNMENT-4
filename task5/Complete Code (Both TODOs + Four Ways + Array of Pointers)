#include <iomanip>
#include <iostream>
#include <string>
using namespace std;
class Cart {
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;
public:
    // TODO 1: Add item and price, return *this
    Cart& add(string item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            n++;
        }
        return *this;
    }
    // TODO 2: Set discount using this pointer
    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;
        for (int i = 0; i < n; ++i)
            t += prices[i];
        return t * (100 - discount) / 100;
    }
};
int main() {
    // (a) Direct object
    Cart c;
    c.add("Rice", 60).add("Dal", 120).setDiscount(10);
    cout << "Direct object: " << c.total() << endl;
    // (b) Pointer to an existing object
    Cart* p = &c;
    p->add("Oil", 180);
    cout << "Pointer: " << p->total() << endl;
    // (c) Reference to an object
    Cart& r = c;
    cout << "Reference: " << r.total() << endl;
    // (d) Dynamically created object
    Cart* d = new Cart;
    d->add("Milk", 50).add("Bread", 40);
    cout << "Dynamic pointer: " << d->total() << endl;
    delete d;
    // Array of pointers to Cart objects
    Cart c1, c2, c3;

    c1.add("Rice", 100);
    c2.add("Oil", 200);
    c3.add("Milk", 150);
    Cart* carts[3] = { &c1, &c2, &c3 };
    Cart* highest = carts[0];
    for (int i = 1; i < 3; i++) {
        if (carts[i]->total() > highest->total()) {
            highest = carts[i];
        }
    }
    cout << "Highest cart total: "
         << highest->total() << endl;
    return 0;
}
